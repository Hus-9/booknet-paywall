<?php require('template/header.phtml') ?>

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>BookNet</title>
    <link rel="stylesheet" href="css_store/max_styles.css">
</head>

<body>

<section class="hero">
    <h1>BookNet</h1>
    <h2>Book Library</h2>
    <p>Explore covers and discover your next read.</p>
</section>

<div class="page">

    <?php if (!empty($view->dbMessage)): ?>
        <div class="message"><?= $view->dbMessage ?></div>
    <?php endif; ?>

    <div class="blocks-card">
        <nav class="blocks" aria-label="Book covers">

            <?php foreach ($view->books as $index => $book): ?>

                <?php
                // Get the cover filename from the BookClass object
                $cover = $book->getCover();

                // Fallback to a placeholder if somehow missing
                if (empty($cover)) {
                    $cover = 'default-placeholder.png';
                }

                // Build the URL path that the browser will request
                $coverPath = 'images/' . htmlspecialchars($cover);

                $gradientNum = ($index % 9) + 1;
                ?>

                <a href="read_book.php?id=<?= urlencode($book->getID()); ?>"
                   class="block"
                   style="--bg: var(--g<?= $gradientNum ?>);">

                    <div class="block__item"
                         role="img"
                         aria-label="<?= htmlspecialchars($book->getTitle()); ?> cover"
                         style="background-image:url('<?= $coverPath ?>');">
                    </div>

                </a>

            <?php endforeach; ?>
        </nav>
    </div>
</div>
</body>
</html>

<?php require('template/footer.phtml'); ?>