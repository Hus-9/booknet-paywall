<!-- Bootstrap + custom JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const toggleButtons   = document.querySelectorAll('.billing-toggle button');
    const priceSpans      = document.querySelectorAll('.price');
    const billingLabels   = document.querySelectorAll('.billing-label');

    // Billing toggle behaviour (original, with no visual change)
    toggleButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            toggleButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const mode = btn.dataset.billing; // "monthly" or "yearly"

            priceSpans.forEach(p => {
                const newValue = p.dataset[mode];
                p.textContent = newValue;
            });

            billingLabels.forEach(label => {
                label.textContent = mode === 'monthly' ? 'mo' : 'yr';
            });
        });
    });

    // Custom modal confirmation logic
    const signupButtons        = document.querySelectorAll('.signup-btn');
    const confirmOverlay       = document.getElementById('confirmOverlay');
    const confirmPlanName      = document.getElementById('confirmPlanName');
    const selectedPlanInput    = document.getElementById('selectedPlanInput');
    const selectedBillingInput = document.getElementById('selectedBillingInput');
    const cancelConfirm        = document.getElementById('cancelConfirm');
    const confirmSubscribe     = document.getElementById('confirmSubscribe');
    const subscriptionForm     = document.getElementById('subscriptionForm');

    function getCurrentBillingMode() {
        const active = document.querySelector('.billing-toggle button.active');
        return active ? active.dataset.billing : 'monthly';
    }

    function openConfirm(plan) {
        confirmPlanName.textContent = plan;
        selectedPlanInput.value     = plan;                 // role value
        selectedBillingInput.value  = getCurrentBillingMode(); // "monthly" or "yearly"
        confirmOverlay.style.display = 'flex';
    }

    function closeConfirm() {
        confirmOverlay.style.display = 'none';
    }

    signupButtons.forEach(button => {
        button.addEventListener('click', function () {
            const plan = this.dataset.plan;

            // Highlight selected card (new behaviour)
            document.querySelectorAll('.pricing-card').forEach(card => {
                card.classList.remove('selected');
            });
            const card = this.closest('.pricing-card');
            if (card) {
                card.classList.add('selected');
            }

            openConfirm(plan);
        });
    });

    cancelConfirm.addEventListener('click', closeConfirm);

    // Close when clicking outside modal
    confirmOverlay.addEventListener('click', function (e) {
        if (e.target === confirmOverlay) {
            closeConfirm();
        }
    });

    confirmSubscribe.addEventListener('click', function () {
        if (subscriptionForm) {
            subscriptionForm.submit();
        }
    });
</script>

